# .streamlit/secrets.toml.template
# Copy to .streamlit/secrets.toml and fill in real values. NEVER commit secrets.toml.

# Google Drive API credentials (service account JSON as a single-line string)
GOOGLE_DRIVE_CREDENTIALS = '{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'

# Google Drive folder ID for team (parent folder)
GOOGLE_DRIVE_TEAM_FOLDER_ID = "<your-drive-folder-id>"

# Approved sign-in accounts (comma/space/semicolon separated). Any address on the
# corporate domain (brincdrones.com) is allowed automatically; list only extras here.
TEAM_EMAILS = "<user@example.com>"

# Google OAuth login block (required to enable the login gate)
# [auth]
# client_id = "<oauth-client-id>"
# client_secret = "<oauth-client-secret>"
# cookie_secret = "<random-long-string>"
# redirect_uri = "<https://your-app/oauth2callback>"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Streamlit configuration
[client]
# Keep false in production — true leaks stack traces / internals to end users.
showErrorDetails = false

[logger]
level = "info"
